# Create udev rule for persistent device naming
# /etc/udev/rules.d/99-serial-devices.rules

# By serial number (most reliable)
SUBSYSTEM=="tty", ATTRS{serial}=="854303533313510111C0", SYMLINK+="touchscreenmacropad"

# Set permissions
SUBSYSTEM=="tty", ATTRS{serial}=="854303533313510111C0", MODE="0666", GROUP="dialout"

# Set up systemd service
SUBSYSTEM=="tty", ATTRS{serial}=="854303533313510111C0", TAG+="systemd", ENV{SYSTEMD_WANTS}="touch-macropad-service.service"

# Run hotplug script (OPTIONAL)
# SUBSYSTEM=="tty", ATTRS{serial}=="854303533313510111C0", RUN+="/usr/local/bin/arduino-connected.sh $env{DEVNAME}"
